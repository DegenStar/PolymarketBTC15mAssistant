# Polymarket BTC 15m Assistant - 环境变量模板
#
# 复制本文件为 `.env`，按需填写：
#   cp .env.example .env
#
# 本项目启动时会自动加载项目根目录下的 `.env`（见 src/loadEnv.js），
# 因此直接 `cp .env.example .env` 后填写即可。
# 已在 shell / 系统环境中导出的同名变量优先级更高，不会被本文件覆盖。
#
# 以下变量均为可选；未设置时使用注释中给出的默认值。
# 请勿在变量值后面写行内注释。

# ---------------------------------------------------------------------------
# Polymarket
# ---------------------------------------------------------------------------

# 是否自动选择最新的 15 分钟市场。可选值：true | false
POLYMARKET_AUTO_SELECT_LATEST=true

# 固定到指定的市场 slug。
# 设置后会覆盖自动选择；留空则使用自动选择。
POLYMARKET_SLUG=

# Polymarket 系列（series）标识。
POLYMARKET_SERIES_ID=10192
POLYMARKET_SERIES_SLUG=btc-up-or-down-15m

# Polymarket 实时数据 WebSocket 地址（Chainlink BTC/USD 当前价格）。
POLYMARKET_LIVE_WS_URL=wss://ws-live-data.polymarket.com

# Polymarket API 返回的结果名称标签（UP / DOWN 两侧）。
POLYMARKET_UP_LABEL=Up
POLYMARKET_DOWN_LABEL=Down

# ---------------------------------------------------------------------------
# Polygon 上的 Chainlink（回退价格源）
# ---------------------------------------------------------------------------

# Polygon 上的 Chainlink BTC/USD 聚合器合约地址。
CHAINLINK_BTC_USD_AGGREGATOR=0xc907E116054Ad103354f2D350FD2514433D57F6f

# 可选的 HTTP RPC 列表，以逗号分隔（优先使用）。
POLYGON_RPC_URLS=https://polygon-rpc.com,https://rpc.ankr.com/polygon

# 可选的单个 HTTP RPC 地址（在 POLYGON_RPC_URLS 之后使用）。
POLYGON_RPC_URL=https://polygon-rpc.com

# 以上两个变量都未设置时，将使用以下内置 RPC：
#   https://polygon-rpc.com, https://rpc.ankr.com/polygon, https://polygon.llamarpc.com

# 可选的 WSS RPC 列表，以逗号分隔（优先使用；推荐配置，回退更实时）。
POLYGON_WSS_URLS=wss://polygon-bor-rpc.publicnode.com

# 可选的单个 WSS RPC 地址（在 POLYGON_WSS_URLS 之后使用）。
POLYGON_WSS_URL=

# ---------------------------------------------------------------------------
# 代理支持（HTTP 请求 + WebSocket 连接）
# ---------------------------------------------------------------------------

# https:// 与 wss:// 目标使用 HTTPS_PROXY，未设置则回退到 ALL_PROXY。
# http:// 与 ws:// 目标使用 HTTP_PROXY，未设置则回退到 ALL_PROXY。
# 同时支持小写变量名：https_proxy、http_proxy、all_proxy。
# 凭据中的特殊字符需要 URL 编码，例如 @ 需写成 %40。

# HTTP/HTTPS 代理
HTTPS_PROXY=
HTTP_PROXY=

# SOCKS5 / 通用代理，例如 socks5://127.0.0.1:1080
ALL_PROXY=

# 带用户名密码的代理示例：
# HTTPS_PROXY=http://USERNAME:PASSWORD@HOST:PORT
# ALL_PROXY=socks5://USERNAME:PASSWORD@HOST:PORT
